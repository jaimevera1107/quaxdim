          "$ref": "#/$defs/time_window"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "access_level": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "mode",
        "preserve_original",
        "accuracy_mode",
        "ambiguous_parse",
        "data_disclosure"
