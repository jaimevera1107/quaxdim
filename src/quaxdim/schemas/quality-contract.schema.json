      "type": "object",
      "required": [],
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "time_field": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "lt",
            "lte",
            "gt",
            "gte",
            "between",
            "exists",
            "not_exists"
          ]
        },
        "value": {},
        "values": {
          "type": "array",
          "items": {},
          "minItems": 0
        },
        "from": {},
        "to": {}
      },
      "additionalProperties": false
    },
    "representation": {
      "type": "object",
      "required": [],
      "properties": {
        "encoding": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "decimal_separator": {
          "type": "string"
        },
        "group_separator": {
          "type": "string"
        },
        "date_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "timezone": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "unicode_normalization": {
          "type": "string",
          "enum": [
            "none",
            "NFC",
            "NFD",
            "NFKC",
            "NFKD"
          ]
        },
        "trim": {
          "type": "boolean"
        },
        "format_hint": {
          "type": "string"
        },
        "formula_policy": {
          "type": "string",
          "enum": [
            "preserve",
            "cached_value",
            "evaluate_if_supported"
          ]
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "missing_policy": {
      "type": "object",
      "required": [],
      "properties": {
        "intrinsic_nulls": {
          "type": "boolean"
        },
        "empty_string": {
          "type": "boolean"
        },
        "whitespace_only": {
          "type": "boolean"
        },
        "nan_is_missing": {
          "type": "boolean"
        },
        "infinities_are_invalid": {
          "type": "boolean"
        },
        "tokens": {
          "type": "array",
          "items": {},
          "minItems": 0
        },
        "normalization": {
          "type": "string",
          "enum": [
            "none",
            "trim",
            "casefold",
            "trim_casefold"
          ]
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "minItems": 0
        }
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": [
        "id",
        "when",
        "logical_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "when": {
          "type": "object",
          "required": [],
          "properties": {
            "source": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "period": {
              "$ref": "#/$defs/time_window"
            },
            "predicates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 0
            }
          },
          "additionalProperties": false
        },
        "logical_type": {
          "type": "string",
          "minLength": 1
        },
        "semantic_type": {
          "type": "string"
        },
        "representation": {
          "$ref": "#/$defs/representation"
        },
        "missing_policy": {
          "$ref": "#/$defs/missing_policy"
        },
        "expected": {
          "$ref": "#/$defs/expectation"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "physical_type",
        "logical_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "physical_type": {
          "type": "string",
          "minLength": 1
        },
        "logical_type": {
          "type": "string",
          "minLength": 1
        },
        "semantic_type": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "representation": {
          "$ref": "#/$defs/representation"
        },
        "missing_policy": {
          "$ref": "#/$defs/missing_policy"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          },
          "minItems": 0
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown"
          ]
        },
        "unit": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "format",
        "shape",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "enum": [
            "table",
            "nested",
            "document",
            "event_stream",
            "time_series",
            "panel",
            "tensor",
            "graph",
            "spatial",
            "raster",
            "unstructured",
            "multimodal",
            "unknown"
          ]
        },
        "adapter": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 0
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "minItems": 0
        },
        "grain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source": {
          "type": "string"
        },
        "valid_time": {
          "$ref": "#/$defs/time_window"
        },
        "metadata": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": [
        "id",
        "name",
        "framework",
        "version",
        "levels",
        "measurement_modes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9_.-]+)?$"
        },
        "family": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "value",
              "field",
              "record",
              "entity",
              "table",
              "dataset",
              "collection",
              "stream",
              "system",
              "use"
            ]
          },
          "minItems": 1
        },
        "measurement_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "internal",
              "contextual",
              "external",
              "subjective",
              "mixed"
            ]
          },
          "minItems": 1
        },
        "related_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "uniqueItems": true
        },
        "overlaps_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "uniqueItems": true
        },
        "inverse_of": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "uniqueItems": true
        },
        "default_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": [
        "id",
        "dimension_ids",
        "version",
        "kind",
        "target_levels",
        "evaluator",
        "unit",
        "direction",
        "denominator_unit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "dimension_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "uniqueItems": true
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9_.-]+)?$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "conformance",
            "descriptive",
            "anomaly",
            "survey",
            "system"
          ]
        },
        "target_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "value",
              "field",
              "record",
              "entity",
              "table",
              "dataset",
              "collection",
              "stream",
              "system",
              "use"
            ]
          },
          "minItems": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "higher_is_better",
            "lower_is_better",
            "target_is_better",
            "neutral"
          ]
        },
        "denominator_unit": {
          "type": "string",
          "minLength": 1
        },
        "numerator_definition": {
          "type": "string"
        },
        "denominator_definition": {
          "type": "string"
        },
        "eligibility": {
          "type": "string"
        },
        "null_policy": {
          "type": "string",
          "enum": [
            "exclude",
            "include_as_failure",
            "include_as_pass",
            "indeterminate",
            "custom"
          ]
        },
        "unknown_policy": {
          "type": "string",
          "enum": [
            "indeterminate",
            "fail",
            "exclude"
          ]
        },
        "evidence_mode": {
          "type": "string",
          "enum": [
            "internal",
            "contextual",
            "external",
            "subjective",
            "mixed"
          ]
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "none",
            "weighted",
            "micro",
            "macro",
            "sum",
            "mean",
            "minimum",
            "maximum",
            "custom"
          ]
        },
        "overlap_group": {
          "type": "string"
        },
        "approximation_allowed": {
          "type": "boolean"
        },
        "supports_incremental": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "expectation": {
      "type": "object",
      "required": [
        "operator"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "not_null",
            "dtype",
            "regex",
            "in_set",
            "reference_lookup",
            "min",
            "max",
            "between",
            "unique",
            "composite_unique",
            "expression",
            "max_delay",
            "has_column",
            "schema",
            "foreign_key",
            "length",
            "temporal_order",
            "custom"
          ]
        },
        "value": {},
        "values": {
          "type": "array",
          "items": {},
          "minItems": 0
        },
        "lower": {},
        "upper": {},
        "pattern": {
          "type": "string"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "key_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "where": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "minItems": 0
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "value",
            "field",
            "record",
            "entity",
            "table",
            "dataset",
            "collection",
            "stream",
            "system",
            "use"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "path": {
          "type": "string"
        },
        "partition_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "time_field": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "threshold": {
      "type": "object",
      "required": [
        "operator",
