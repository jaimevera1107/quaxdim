      ],
      "properties": {
        "operator": {
          "type": "string",
          "enum": [
            "gte",
            "gt",
            "lte",
            "lt",
            "eq",
            "between"
          ]
        },
        "value": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "version",
        "asset_id",
        "metric_id",
        "target",
        "expectation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
