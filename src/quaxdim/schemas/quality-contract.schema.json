{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/quality-dimensions/schemas/quality-contract-0.2.0.json",
  "title": "Quality Dimensions — Evaluation Contract",
  "description": "Schema sintáctico. La validación semántica de dependencias, evidencias y comparabilidad requiere un paso adicional.",
  "type": "object",
  "required": [
    "contract_version",
    "assets",
    "dimensions",
    "metrics",
    "rules",
    "evaluation"
  ],
