          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9_.-]+)?$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "metric_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "description": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "minItems": 0
        },
        "when_period": {
          "$ref": "#/$defs/time_window"
        },
        "expectation": {
          "$ref": "#/$defs/expectation"
        },
        "threshold": {
          "$ref": "#/$defs/threshold"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "on_missing_evidence": {
          "type": "string",
          "enum": [
            "missing_evidence",
            "blocked_dependency",
            "technical_error"
          ]
        },
        "failure_action": {
          "type": "string",
          "enum": [
            "report",
            "warn",
            "block",
            "quarantine_proposal"
