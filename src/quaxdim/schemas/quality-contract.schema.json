          "minItems": 0
        },
        "extensions": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "official_catalog",
            "reference_dataset",
            "data_contract",
            "documentation",
            "audit_log",
            "metadata",
            "survey",
            "business_rule",
            "other"
          ]
        },
        "uri": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
