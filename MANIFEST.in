include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include contracts *.json *.yaml
recursive-include docs *.md *.csv
recursive-include examples *.py *.yaml *.json
recursive-include tests *.py
recursive-include tests_validation *.py
recursive-include tests_public *.py
recursive-include src/quaxdim/schemas *.json
include src/quaxdim/py.typed
prune .github
prune scripts
prune benchmarks
prune build
prune dist
prune reportes
global-exclude __pycache__ *.py[cod] .DS_Store *.log *.xml
